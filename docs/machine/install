#!/usr/bin/env bash
# Install the TestFlows™ Machine client.
#
#   curl https://testflows.com/machine/install -fsS | bash
#
# The client is given to a TestFlows account. The script signs in, or creates an account,
# at the terminal: an email, and a code sent to it. The Terms of Service license the
# client, https://testflows.com/machine/legal/terms-of-service/. An account that has not
# accepted their current version is shown them in full, and accepts them before anything
# is downloaded. Without a terminal it takes an API key, TESTFLOWS_MACHINE_API_KEY, whose account
# has accepted them. It signs out when it ends; `machine login` signs the client in.
#
# It downloads one file, the `machine` binary, checks it against the SHA-256
# checksum published next to it, and puts it in ~/.local/bin. It also writes
# machine-env there, a shell in which `machine` is this client. It never asks for
# root. Where another program called machine is already on PATH, as /usr/bin/machine
# is on a Mac, `machine` goes to ~/.local/share/machine/bin instead, which is not on
# PATH, and ~/.local/bin holds machine-env alone. Putting ~/.local/bin on PATH then
# hides nothing. The checksum is signed with the release keys below, GPG and RSA, and the
# signature is checked before the checksum is trusted: with gpg where there is one,
# else with openssl, which every Mac has. The download itself is protected by HTTPS, which is the only protocol it will use unless
# MACHINE_BASE_URL is set to an http:// address, as a local mirror for testing.
#
# On first run the client unpacks itself into ~/.cache/machine/.
# After an update this script removes the folders older versions unpacked.
#
# To check a download yourself, print the checksum published for a version and
# compare it with `sha256sum` of your file:
#
#   curl https://testflows.com/machine/install -fsS | bash -s -- --checksum
#
# To see the versions there are, and install one of them:
#
#   curl https://testflows.com/machine/install -fsS | bash -s -- --list
#   curl https://testflows.com/machine/install -fsS | bash -s -- --version 20261007-2203
#
# Environment:
#   MACHINE_INSTALL_DIR   where to put machine-env, and machine when no other program
#                         called machine is on PATH (default: ~/.local/bin)
#   MACHINE_VERSION       a version to install, YYYYMMDD-HHMM (default: the latest)
#   MACHINE_NO_MODIFY_PATH  set to anything, the script does not ask to put the install
#                         directory on PATH in your shell's startup file. It asks only at
#                         a terminal, and writes only when the answer is yes.
#   TESTFLOWS_MACHINE_API_KEY
#                         an API key to install with, in place of signing in at a
#                         terminal; the client reads the same variable
#   MACHINE_BASE_URL      a mirror to download releases from, with no sign-in, for testing
#
# Everything happens inside main(), which is only called on the last line. If the
# download is cut short, bash never reaches that line and nothing runs.

# Piped into sh, which is dash on Debian and Ubuntu, the next line fails with
# "set: Illegal option -o pipefail" and names nothing the reader can act on.
# Written for any POSIX shell, since this is the one line another shell runs.
if [ -z "${BASH_VERSION:-}" ]; then
    echo "This installer needs bash." >&2
    echo "Install with curl https://testflows.com/machine/install -fsS | bash" >&2
    exit 1
fi

set -euo pipefail

# The service an account signs in to, which gives a signed-in account a link to each
# release file. A mirror named by MACHINE_BASE_URL, a test server, is read as it is, with
# no sign-in.
API_URL="${TESTFLOWS_MACHINE_API_URL:-https://machine-api.testflows.com}"
MIRROR="${MACHINE_BASE_URL:-}"
MIRROR="${MIRROR%/}"
BASE_URL="${MIRROR:-$API_URL}"
# A release from the official server must be signed; a mirror may not be, and is only
# warned about.
OFFICIAL=true
[ -n "$MIRROR" ] && OFFICIAL=false
# Rounds of proof of work a sign-in answers before it gives up: the service asks for more
# when one email is asked for often.
POW_ROUNDS=3
# Codes a person may type before the installer stops and they start again.
CODE_TRIES=3
HELPER=""
API_POW=""
API_HEADERS=""
API_BODY=""
API_STATUS=""
SIGNED_IN=""
ACCOUNT=""
# The Terms of Service, which license the client: the Markdown of their page on
# testflows.com, which the installer shows in full before they are accepted.
TERMS_URL="${MACHINE_TERMS_URL:-https://testflows.com/machine/legal/terms-of-service.md}"
TERMS_PAGE="https://testflows.com/machine/legal/terms-of-service/"
# Whether a download shows a progress bar: the client's own file does, and the small
# files around it, its checksum and the version names, are fetched quietly.
FETCH_PROGRESS=false

# The release signing keys. Every release's checksum files are signed with both: the GPG
# key for gpg, the RSA key for openssl. Fingerprint 5F3621A5081FF68BFF2581FDB280231700CCCA66.
GPG_PUBLIC_KEY="$(cat <<'KEY'
