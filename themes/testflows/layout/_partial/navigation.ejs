<%
/* One chrome for the whole site; the menu item for the current section is marked. */
var navPath = '/' + String(page.path || '').replace(/index\.html$/, '');
function navSection(item) {
    if (item === 'Machine') return navPath.indexOf('/machine/') === 0 && navPath.indexOf('/machine/legal/') !== 0;
    if (item === 'Docs') return navPath.indexOf('/docs/') === 0;
    if (item === 'Framework') return navPath.indexOf('/framework/') === 0;
    if (item === 'Blog') return navPath.indexOf('/blog/') === 0;
    if (item === 'Contact') return navPath.indexOf('/contact') === 0;
    return false;
}
%>
<nav id="main-nav" class="navbar navbar-expand-lg fixed-top" role="navigation">
    <div class="container navbar-inner">
        <a class="navbar-brand" href="<%- config.root %>">
            <img
                class="navbar-logo"
                id="navbar-logo"
                src="<%- config.root %>img/logo-simple-modern.png"
                data-logo-dark="<%- config.root %>img/logo-simple-modern.png"
                data-logo-light="<%- config.root %>img/logo-simple-modern-light.png"
                alt="TestFlows"
            >
        </a>
        <script>
        (function () {
            var logo = document.getElementById("navbar-logo");
            if (!logo) return;
            var theme = document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
            var src = theme === "light"
                ? logo.getAttribute("data-logo-light")
                : logo.getAttribute("data-logo-dark");
            if (src) logo.setAttribute("src", src);
        })();
        </script>
        <button class="navbar-toggler" type="button"
                data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-bars" aria-hidden="true">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </span>
        </button>
        <div class="collapse navbar-collapse site-menu" id="navbarNav">
            <div class="site-menu-panel">
                <ul class="navbar-nav">
                    <%
                    var menuGlyphs = {
                        Framework: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="m8 8-4 4 4 4"/><path d="m16 8 4 4-4 4"/><path d="m13.5 5-3 14"/></svg>',
                        Machine: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3z"/><path d="m4 7.5 8 4.5 8-4.5"/><path d="M12 12v9"/></svg>',
                        Docs: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5V5.5z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M8 7h8M8 11h6"/></svg>',
                        Blog: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h10l4 4v12H5V4z"/><path d="M15 4v4h4"/><path d="M8 12h8M8 16h5"/></svg>',
                        Contact: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>'
                    };
                    %>
                    <% for (var i in config.menu) { %>
                        <li class="nav-item<%= navSection(i) ? ' active' : '' %>">
                            <span class="site-menu-glyph" aria-hidden="true"><%- menuGlyphs[i] || '' %></span>
                            <a class="nav-link" href="<%- url_for(config.menu[i].path) %>"<%- navSection(i) ? ' aria-current="page"' : '' %>><%= i %></a>
                        </li>
                    <% } %>
                </ul>
            </div>
            <div class="site-menu-footer">
                <a class="site-menu-action" href="<%- url_for('machine/portal/login/') %>">
                    <span class="fas fa-right-to-bracket" aria-hidden="true"></span>
                    <span class="site-menu-action-label">Machine sign in</span>
                </a>
                <a class="site-menu-action" href="https://pypi.org/project/testflows/">
                    <span class="fab fa-python" aria-hidden="true"></span>
                    <span class="site-menu-action-label">pip3 install testflows</span>
                </a>
                <a class="site-menu-action" href="https://github.com/testflows">
                    <span class="fab fa-github" aria-hidden="true"></span>
                    <span class="site-menu-action-label">GitHub</span>
                </a>
            </div>
        </div>
        <div class="navbar-github-slot">
            <button type="button" class="navbar-theme" id="theme-toggle" aria-label="Switch to light theme" title="Theme">
                <span class="fas fa-sun navbar-theme-sun" aria-hidden="true"></span>
                <span class="fas fa-moon navbar-theme-moon" aria-hidden="true"></span>
            </button>
            <a class="navbar-github navbar-github-icon" href="https://github.com/testflows" aria-label="GitHub" title="GitHub">
                <span class="fab fa-github" aria-hidden="true"></span>
                <span class="navbar-github-label">GitHub</span>
            </a>
            <% if (navPath.indexOf('/machine/portal/login/') !== 0) { %>
            <a class="navbar-signin-btn" id="navbar-signin" href="<%- url_for('machine/portal/login/') %>">Sign in</a>
            <script>
            (function () {
                var a = document.getElementById("navbar-signin");
                if (!a || document.cookie.indexOf("tf_machine_email=") < 0) return;
                a.textContent = "Account";
                a.setAttribute("href", "<%- url_for('machine/portal/account/') %>");
            })();
            </script>
            <% } %>
        </div>
    </div>
</nav>
