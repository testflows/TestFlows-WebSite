<nav id="main-nav" class="navbar navbar-expand-md fixed-top" role="navigation">
    <div class="container navbar-inner">
        <a class="navbar-brand" href="<%- config.root %>">
            <img
                class="navbar-logo"
                id="navbar-logo"
                src="<%- config.root %>img/logo-simple-modern.png"
                data-logo-dark="<%- config.root %>img/logo-simple-modern.png"
                data-logo-light="<%- config.root %>img/logo-simple-modern-light.png"
                alt="TestFlows"
            >
        </a>
        <script>
        (function () {
            var logo = document.getElementById("navbar-logo");
            if (!logo) return;
            var theme = document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
            var src = theme === "light"
                ? logo.getAttribute("data-logo-light")
                : logo.getAttribute("data-logo-dark");
            if (src) logo.setAttribute("src", src);
        })();
        </script>
        <button class="navbar-toggler" type="button"
                data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-bars" aria-hidden="true">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </span>
        </button>
        <div class="collapse navbar-collapse site-menu" id="navbarNav">
            <div class="site-menu-panel">
                <ul class="navbar-nav">
                    <%
                    var menuGlyphs = {
                        Handbook: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5V5.5z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M8 7h8M8 11h6"/></svg>',
                        Blog: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h10l4 4v12H5V4z"/><path d="M15 4v4h4"/><path d="M8 12h8M8 16h5"/></svg>',
                        About: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 10v6"/><path d="M12 7.5h.01"/></svg>',
                        Contact: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>'
                    };
                    %>
                    <% for (var i in config.menu) { %>
                        <li class="nav-item">
                            <span class="site-menu-glyph" aria-hidden="true"><%- menuGlyphs[i] || menuGlyphs.About %></span>
                            <a class="nav-link" href="<%- url_for(config.menu[i].path) %>"><%= i %></a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
        <div class="navbar-github-slot">
            <button type="button" class="navbar-theme" id="theme-toggle" aria-label="Switch to light theme" title="Theme">
                <span class="fas fa-sun navbar-theme-sun" aria-hidden="true"></span>
                <span class="fas fa-moon navbar-theme-moon" aria-hidden="true"></span>
            </button>
            <span class="navbar-github-sep" aria-hidden="true">|</span>
            <a class="navbar-github" href="https://github.com/testflows">
                <span class="fab fa-github" aria-hidden="true"></span>
                GitHub
            </a>
        </div>
    </div>
</nav>
