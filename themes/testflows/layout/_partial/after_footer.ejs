<%# No third-party script loads from another origin: the API trusts this whole origin with a signed-in visitor's cookie, so any page's script can call it as the visitor. The analytics beacon is a reviewed copy served from here, Cloudflare's 2026.10.1, sha384-DSBfgE0somecFTMgit0M4sNXN8O0JQ/LGM3DGGPVvgXIPZvW+H1zSYjc6O83LLBv; it reads no cookies or storage and sends only to cloudflareinsights.com. Replace it only with a version read the same way. It sends the page's full URL, so the portal's pages, whose URLs carry sign-in and account parameters, do not load it. %>
<%# The cookie notice informs and asks nothing: the site sets essential cookies alone and its analytics set none. A tool that sets non-essential cookies needs a consent prompt in its place, with the tool held until the visitor accepts. %>
<% if (theme.cookie_notice) { %>
<% var tPolicy =String(page.path || '').indexOf('machine/') === 0 ? 'machine/legal/privacy-policy/#6-cookies-and-analytics' : 'legal/privacy-policy/#5-cookies-and-choices'; %>
<div class="cookie-notice" id="cookie-notice" role="region" aria-label="Cookie notice" hidden>
  <p>We use essential cookies for sign-in and security, and cookie-free analytics to see how our pages are used. <a href="<%- config.root %><%- tPolicy %>">Privacy Policy</a></p>
  <button type="button" class="cookie-notice-ok" id="cookie-notice-ok">OK</button>
  <button type="button" class="cookie-notice-close" id="cookie-notice-close" aria-label="Close the cookie notice">&times;</button>
</div>
<script>
(function () {
  var key = "tf-cookie-notice";
  var notice = document.getElementById("cookie-notice");
  try {
    if (localStorage.getItem(key) === "seen") return;
  } catch (e) {}
  notice.hidden = false;
  var dismiss = function () {
    notice.hidden = true;
    try {
      localStorage.setItem(key, "seen");
    } catch (e) {}
  };
  document.getElementById("cookie-notice-ok").addEventListener("click", dismiss);
  document.getElementById("cookie-notice-close").addEventListener("click", dismiss);
})();
</script>
<% } %>
