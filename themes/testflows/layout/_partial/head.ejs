<head>
  <meta charset="utf-8">
  <script>document.documentElement.classList.add("js");</script>
  <script>
  (function () {
    try {
      var t = localStorage.getItem("tf-theme");
      if (t !== "light" && t !== "dark") t = "dark";
      document.documentElement.setAttribute("data-theme", t);
    } catch (e) {
      document.documentElement.setAttribute("data-theme", "dark");
    }
  })();
  </script>
  <% if (page.portal_auth_gate) { %>
  <% /* Sync gate before body paints — module boot is too late (flashes the dash). */ %>
  <script>
  (function () {
    var prefix = "tf_machine_email=";
    var parts = document.cookie.split("; ");
    for (var i = 0; i < parts.length; i++) {
      if (parts[i].indexOf(prefix) === 0 && parts[i].length > prefix.length) {
        return;
      }
    }
    location.replace("<%- config.root %>machine/portal/login/");
  })();
  </script>
  <% } %>
  <%
  /* Tab title: "Page | TestFlows" for landing pages, "Page | Area" for pages inside an area. */
  var tPath = String(page.path || '');
  var tArea = '';
  if (tPath.indexOf('docs/framework/') === 0 || tPath.indexOf('docs/machine/') === 0) tArea = 'Docs';
  else if (tPath.indexOf('machine/portal/') === 0 || tPath === 'machine/download/index.html') tArea = 'Machine';
  else if (tPath.indexOf('machine/legal/') === 0 && tPath !== 'machine/legal/index.html') tArea = 'Machine Legal';
  else if (tPath.indexOf('legal/') === 0 && tPath !== 'legal/index.html') tArea = 'Legal';
  else if (page.post) tArea = 'Blog';
  %>
  <title><% if (tPath === 'index.html') { %>TestFlows<% } else { %><%- page.title || config.title %> | <%- tArea || 'TestFlows' %><% } %></title>
  <meta name="description" content="<%- page.description || config.description %>">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="author" content="<%- page.author || 'TestFlows'%>">
  <meta name="og:site_name" content="TestFlows">
  <meta property="og:image" content="<%- full_url_for(page.image || config.social_share) %>">
  <% if (page.post) { %>
  <%- partial('_partial/post_meta') %>
  <% } %>
  <% if (theme.favicon){ %>
  <link href="<%- full_url_for(theme.favicon) %>" rel="icon">
  <% } %>
  <link href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%- config.root %>css/bootstrap/bootstrap.css" media="screen" type="text/css">
  <link rel="stylesheet" href="<%- config.root %>css/highlight.css?v=<%- Date.now() %>" media="screen" type="text/css">
  <link rel="stylesheet" href="<%- config.root %>css/fontawesome/css/all.css?v=1.0" type="text/css">
  <% /* Theme modules — order: tokens → base → chrome → pages */ %>
  <% var tfCss = ['tokens','base','nav','footer','hero','index','machine','blog','contact','legal','docs','home','portal','content','misc']; %>
  <% tfCss.forEach(function (name) { %>
  <link rel="stylesheet" href="<%- config.root %>css/tf/<%= name %>.css?v=<%- Date.now() %>" media="screen" type="text/css">
  <% }); %>
  <!--[if lt IE 9]>
  <script src="//html5shiv.googlecode.com/svn/trunk/html5.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/es5-shim/4.5.9/es5-shim.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/es5-shim/4.5.7/es5-sham.min.js"></script>
  <![endif]-->
</head>
