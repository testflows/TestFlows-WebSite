<head>
  <meta charset="utf-8">
  <script>document.documentElement.classList.add("js");</script>
  <script>
  (function () {
    try {
      var t = localStorage.getItem("tf-theme");
      if (t !== "light" && t !== "dark") t = "dark";
      document.documentElement.setAttribute("data-theme", t);
    } catch (e) {
      document.documentElement.setAttribute("data-theme", "dark");
    }
  })();
  </script>
  <% if (page.portal_auth_gate) { %>
  <% /* Sync gate before body paints — module boot is too late (flashes the dash). */ %>
  <script>
  (function () {
    var prefix = "tf_machine_email=";
    var parts = document.cookie.split("; ");
    for (var i = 0; i < parts.length; i++) {
      if (parts[i].indexOf(prefix) === 0 && parts[i].length > prefix.length) {
        return;
      }
    }
    location.replace("<%- config.root %>machine/portal/login/");
  })();
  </script>
  <% } %>
  <%
  /* Tab title: "Page | TestFlows" for landing pages, "Page | Area" for pages inside an area. */
  var tPath = String(page.path || '');
  var tArea = '';
  if (tPath.indexOf('docs/framework/') === 0 || tPath.indexOf('docs/machine/') === 0) tArea = 'Docs';
  else if (tPath.indexOf('machine/portal/') === 0 || tPath === 'machine/download/index.html') tArea = 'Machine';
  else if (tPath.indexOf('machine/legal/') === 0) tArea = 'Machine Legal';
  else if (tPath.indexOf('legal/') === 0 && tPath !== 'legal/index.html') tArea = 'Legal';
  else if (page.post) tArea = 'Blog';
  %>
  <title><% if (tPath === 'index.html') { %>TestFlows<% } else { %><%- page.title || config.title %> | <%- tArea || 'TestFlows' %><% } %></title>
  <meta name="description" content="<%- page.description || config.description %>">
  <%# The address a page answers to, for search engines. Not for the 404 page or pages that are nothing until you sign in. %>
  <% var tCanon = full_url_for(tPath.replace(/index\.html$/, '')); %>
  <% if (tPath !== '404.html' && !page.noindex) { %><link rel="canonical" href="<%- tCanon %>"><% } %>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <%# noindex: true in a page's front matter, for pages that are nothing until you sign in. %>
  <% if (page.noindex) { %><meta name="robots" content="noindex"><% } %>
  <meta name="author" content="<%- page.author || 'TestFlows'%>">
<%- partial('_partial/ai_markdown', {part: 'head'}) %>
  <meta property="og:site_name" content="TestFlows">
  <% if (page.post) { %>
  <%- partial('_partial/post_meta') %>
  <% } else { %>
  <%# How a page looks when it is shared. A post says it in post_meta, with its own image. %>
  <% var tShare = tPath === 'index.html' ? 'TestFlows' : (page.title || config.title); var tShareDesc = page.description || config.description; var tShareImg = full_url_for(page.image || config.social_share); %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= tShare %>">
  <meta property="og:description" content="<%= tShareDesc %>">
  <meta property="og:url" content="<%- tCanon %>">
  <meta property="og:image" content="<%- tShareImg %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= tShare %>">
  <meta name="twitter:description" content="<%= tShareDesc %>">
  <meta name="twitter:image" content="<%- tShareImg %>">
  <% } %>
  <% if (theme.favicon){ %>
  <link href="<%- full_url_for(theme.favicon) %>" rel="icon">
  <% } %>
  <%# Every asset from this site: a file from another host sends it each visitor's address. %>
  <link rel="stylesheet" href="<%- config.root %>css/fonts.css?v=1" type="text/css">
  <%# The math styles only where a page renders math: hexo-math's injector, off in _config.yml, put them on every page. %>
  <%# A listing renders its posts' excerpts: blog.ejs from site.posts, an archive from page.posts. %>
  <% var listed = page.layout === 'blog' ? site.posts.toArray() : (page.posts && page.posts.toArray ? page.posts.toArray() : []); %>
  <% var mathText = String(page.content || '') + listed.map(function (p) { return String(p.excerpt || ''); }).join(''); %>
  <% if (/class="katex|<mjx-container/.test(mathText)) { %>
  <link rel="stylesheet" href="<%- config.root %>css/math/katex.min.css?v=1" type="text/css">
  <link rel="stylesheet" href="<%- config.root %>css/math/hexo-math.css?v=1" type="text/css">
  <% } %>
  <link rel="stylesheet" href="<%- config.root %>css/bootstrap/bootstrap.css" media="screen" type="text/css">
  <link rel="stylesheet" href="<%- config.root %>css/highlight.css?v=<%- Date.now() %>" media="screen" type="text/css">
  <link rel="stylesheet" href="<%- config.root %>css/fontawesome/css/all.css?v=1.0" type="text/css">
  <% /* Theme modules — order: tokens → base → chrome → pages */ %>
  <% var tfCss = ['tokens','base','nav','footer','hero','index','machine','blog','contact','legal','docs','home','portal','content','misc']; %>
  <% tfCss.forEach(function (name) { %>
  <link rel="stylesheet" href="<%- config.root %>css/tf/<%= name %>.css?v=<%- Date.now() %>" media="screen" type="text/css">
  <% }); %>
</head>
