<%
var isMachineSurface = page.path && page.path.indexOf('machine/') === 0;
var footerContact = isMachineSurface ? '/machine/contact/' : '/contact.html';
var footerLegal = isMachineSurface ? '/machine/legal/' : '/legal/';
%>
<div class="container">
    <div class="site-footer-grid row">
        <div class="col-6 col-md-3 site-footer-col">
            <h3>Developers</h3>
            <ul>
                <li><a href="<%- url_for('/handbook/') %>">Handbook</a></li>
                <li><a href="<%- url_for('/blog/') %>">Blog</a></li>
            </ul>
        </div>
        <div class="col-6 col-md-3 site-footer-col">
            <h3>Community</h3>
            <ul>
                <li><a href="https://github.com/testflows">GitHub</a></li>
                <li><a href="https://pypi.org/project/testflows/">PyPI</a></li>
                <li><a href="https://www.linkedin.com/company/testflows-com-open-source-testing-framework/">LinkedIn</a></li>
                <li><a href="https://x.com/TestFlowsOSTF">X</a></li>
            </ul>
        </div>
        <div class="col-6 col-md-3 site-footer-col">
            <h3>Company</h3>
            <ul>
                <li><a href="<%- url_for('/about.html') %>">About</a></li>
                <li><a href="<%- url_for(footerContact) %>">Contact</a></li>
                <li><a href="<%- url_for(footerLegal) %>">Legal</a></li>
            </ul>
        </div>
        <div class="col-6 col-md-3 site-footer-col">
            <h3>Get started</h3>
            <ul>
                <% if (isMachineSurface) { %>
                <li><a href="<%- url_for('/machine/portal/signup/') %>">Create account</a></li>
                <li><a href="<%- url_for('/machine/contact/') %>">Request early access</a></li>
                <% } else { %>
                <li><a href="https://pypi.org/project/testflows/">pip3 install testflows</a></li>
                <li><a href="<%- url_for('/handbook/') %>">Read the handbook</a></li>
                <% } %>
            </ul>
        </div>
    </div>
    <div class="site-footer-bottom">
        <div>
            Copyright 2020-<%= new Date().getFullYear() %> Katteli Inc. All rights reserved.
        </div>
        <div class="site-footer-social">
            <a href="https://pypi.org/project/testflows/" aria-label="PyPI"><span class="fab fa-python"></span></a>
            <a href="https://www.linkedin.com/company/testflows-com-open-source-testing-framework/" aria-label="LinkedIn"><span class="fab fa-linkedin"></span></a>
            <a href="https://x.com/TestFlowsOSTF" aria-label="X"><span class="fab fa-x-twitter"></span></a>
            <a href="https://github.com/testflows" aria-label="GitHub"><span class="fab fa-github"></span></a>
        </div>
    </div>
</div>
