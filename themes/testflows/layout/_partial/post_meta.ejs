<% /* social_image: a full-size copy for share previews, which need 1200px; image stays the list's thumbnail. */ var pImage = full_url_for(page.social_image || page.image || config.social_share); var pDesc = page.description || config.description; %>
<meta name="publish_date" property="og:publish_date" content="<%- date(page.date, 'YYYY-MM-DDTHH:mm:ss-0000') %>">
<meta property="og:type" content="article">
<meta property="article:published_time" content="<%- date(page.date, 'YYYY-MM-DDTHH:mm:ss-0000') %>" />
<meta property="og:title" content="<%= page.title %>">
<meta property="og:description" content="<%= pDesc %>">
<meta property="og:url" content="<%- full_url_for(String(page.path).replace(/index\.html$/, '')) %>">
<meta property="og:image" content="<%- pImage %>">
<%# A share image states its size, so a preview lays out its card without fetching the image first. %>
<% if (page.social_image && page.social_image_width && page.social_image_height) { %>
<meta property="og:image:width" content="<%= page.social_image_width %>">
<meta property="og:image:height" content="<%= page.social_image_height %>">
<% } %>
<%# Post covers are square: a summary card shows them whole, where a large card crops them to 2:1. A
    social_image is landscape, made for the large card. %>
<meta name="twitter:card" content="<%= page.social_image ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= page.title %>">
<meta name="twitter:description" content="<%= pDesc %>">
<meta name="twitter:image" content="<%- pImage %>">
<%# Structured data: the post as an article, for search engines. %>
<% var pLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": page.title,
  "description": pDesc,
  "image": pImage,
  "datePublished": date(page.date, 'YYYY-MM-DDTHH:mm:ssZ'),
  "dateModified": date((page.updated && page.updated > page.date) ? page.updated : page.date, 'YYYY-MM-DDTHH:mm:ssZ'),
  "author": {"@type": "Person", "name": page.author || "TestFlows"},
  "publisher": {"@type": "Organization", "name": "TestFlows", "url": "https://testflows.com/", "logo": {"@type": "ImageObject", "url": full_url_for(config.image)}},
  "mainEntityOfPage": full_url_for(String(page.path).replace(/index\.html$/, ''))
}; %>
<script type="application/ld+json"><%- JSON.stringify(pLd).replace(/</g, '\\u003c') %></script>
