<% var pImage = full_url_for(page.image || config.social_share); var pDesc = page.description || config.description; %>
<meta name="publish_date" property="og:publish_date" content="<%- date(page.date, 'YYYY-MM-DDTHH:mm:ss-0000') %>">
<meta property="og:type" content="article">
<meta property="article:published_time" content="<%- date(page.date, 'YYYY-MM-DDTHH:mm:ss-0000') %>" />
<meta property="og:title" content="<%= page.title %>">
<meta property="og:description" content="<%= pDesc %>">
<meta property="og:url" content="<%- full_url_for(String(page.path).replace(/index\.html$/, '')) %>">
<meta property="og:image" content="<%- pImage %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= page.title %>">
<meta name="twitter:description" content="<%= pDesc %>">
<meta name="twitter:image" content="<%- pImage %>">
