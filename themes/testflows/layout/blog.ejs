<section class="blog-page">
    <div class="container blog-page-inner">
        <header class="blog-hero">
            <h1>Journal about testing</h1>
            <p class="blog-lead">Deep dives on test programs, combinatorial coverage, behavior models, and shipping quality software.</p>
        </header>
        <div class="blog-list">
<% site.posts.sort('date', 'desc').forEach(function(item) { %>
            <article class="blog-card">
                <div class="blog-card-copy">
                    <h2 class="blog-card-title">
                        <a href="<%- item.permalink %>"><%- item.title %></a>
                    </h2>
                    <div class="blog-card-excerpt">
                        <%- item.excerpt %>
                    </div>
                    <div class="blog-card-meta">
                        <span class="blog-card-author"><%- item.author %></span>
                        <time datetime="<%= date(item.date, 'YYYY-MM-DD') %>"><%= date(item.date, 'MMMM D, YYYY') %></time>
                    </div>
                    <a class="blog-card-more" href="<%- item.permalink %>">Read more <span class="fas fa-arrow-right" aria-hidden="true"></span></a>
                </div>
                <% if (item.image) { %>
                <div class="blog-card-media">
                    <a href="<%- item.permalink %>" tabindex="-1" aria-hidden="true">
                        <img src="<%- url_for(item.image) %>" alt="">
                    </a>
                </div>
                <% } %>
            </article>
<% }); %>
        </div>
    </div>
</section>
