<div class="container" style="padding-bottom: 2em !important">
    <div class="post-header row">
        <div class="post-summary col-lg-6 mt-auto mb-auto">
            <h1 style="font-weight: bold;"><%- page.title %></h1>
            <div class="post-metadata">
                <div class="post-author">
                    <span class="author-title text-nowrap">Written By</span><span class="author-name"><%- page.author %></span>
                    <time datetime="<%- date(page.date, 'YYYY-MM-DDTHH:mm:ss-0000') %>"><span class="authored-date text-nowrap"><%= date(page.date, 'MMM D, YYYY') %></span></time>
                </div>
                <div class="post-share btn-group" role="group" aria-label="share">
                    <span class="caption">Share It</span>
                    <a href="https://twitter.com/intent/tweet?url=<%- page.permalink %>">
                        <i class="fab fa-2x fa-twitter"></i>
                    </a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u=<%- page.permalink %>">
                        <i class="fab fa-2x fa-facebook"></i>
                    </a>
                    <a href="https://www.linkedin.com/shareArticle?mini=true&url=<%- page.permalink %>">
                        <i class="fab fa-2x fa-linkedin"></i>
                    </a>
                </div>
            </div>
        </div>
        <% if (page.image) { %>
        <div class="post-image col-lg-6 m-auto">
            <img src="<%- config.root %><%- page.image %>" alt="<%= page.title %>">
            <span class="post-image-credit"><%- page.image.credit %></span>
        </div>
        <% } %>
    </div>
    <%
    /* A post with three sections or more gets a contents panel beside it; `toc: false` in its front matter turns it off.
       Older posts mark their sections with h1, newer ones with h2: the panel lists the top level the post uses. */
    var h1Count = (page.content.match(/<h1[\s>]/g) || []).length;
    var h2Count = (page.content.match(/<h2[\s>]/g) || []).length;
    var sectionLevel = h1Count >= 3 ? 1 : 2;
    var sectionCount = sectionLevel === 1 ? h1Count : h2Count;
    var showToc = page.toc !== false && sectionCount >= 3;
    %>
    <div class="blog post-body row">
        <% if (showToc) { %>
        <nav id="post-contents" class="post-toc col-lg-3" aria-label="Contents">
            <div class="post-toc-inner">
                <%- toc(page.content, { list_number: false, min_depth: sectionLevel, max_depth: sectionLevel }) %>
            </div>
        </nav>
        <% } %>
        <div class="post-content <%= showToc ? 'col-lg-9' : 'col-12' %>">
            <%- page.content %>
        </div>
        <% if (showToc) { %>
        <script>
        var postSectionSelector = ".post-content h<%= sectionLevel %>[id]";
        /* Highlight the contents link of the section being read. */
        (function () {
            var links = document.querySelectorAll(".post-toc .toc-link");
            var byId = {};
            links.forEach(function (link) {
                byId[decodeURIComponent(link.getAttribute("href").slice(1))] = link;
            });
            var headings = Array.prototype.filter.call(
                document.querySelectorAll(postSectionSelector),
                function (h) { return byId[h.id]; }
            );
            if (!("IntersectionObserver" in window) || !headings.length) {
                return;
            }
            var current = null;
            function activate(id) {
                if (current) { current.classList.remove("active"); }
                current = byId[id];
                if (current) { current.classList.add("active"); }
            }
            var observer = new IntersectionObserver(function () {
                var top = null;
                headings.forEach(function (h) {
                    if (h.getBoundingClientRect().top < window.innerHeight * 0.3) { top = h; }
                });
                activate(top ? top.id : headings[0].id);
            }, { rootMargin: "0px 0px -70% 0px", threshold: [0, 1] });
            headings.forEach(function (h) { observer.observe(h); });
        })();
        /* A section title takes the reader back to the contents. */
        (function () {
            var contents = document.getElementById("post-contents");
            document.querySelectorAll(postSectionSelector).forEach(function (h) {
                h.classList.add("post-section-title");
                h.setAttribute("title", "Back to contents");
                h.addEventListener("click", function () {
                    var top = contents.getBoundingClientRect().top + window.scrollY;
                    if (window.matchMedia("(min-width: 992px)").matches) {
                        top = contents.parentElement.getBoundingClientRect().top + window.scrollY;
                    }
                    window.scrollTo({ top: Math.max(0, top - 96), behavior: "smooth" });
                });
            });
        })();
        </script>
        <% } %>
        <div class="handbook-jump">
            <button type="button" class="handbook-jump-top" onclick="window.scrollTo({ top: 0, behavior: (window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth') });" aria-label="Back to top">
                <span class="fas fa-chevron-up" aria-hidden="true"></span>
            </button>
        </div>
        <div class="col-12 divider"></div>
        <div class="post-footer"></div>

        <!-- Read Next Carousel Section -->
        <% 
        var postsPerSlide = 2; // Adjust based on screen size if needed
        var recentPosts = site.posts.sort('date', 'desc').filter(p => p.path !== page.path).toArray();
        var totalSlides = recentPosts.length; // Calculate total slides
        if (totalSlides > 0) { 
        %>
            <div id="readNextCarousel" class="carousel slide col-12" data-ride="carousel" data-interval="5000">
                <div class="carousel-inner">
                    <% for (var postIndex = 0; postIndex < totalSlides; postIndex++) { %>
                        <div class="carousel-item <%= postIndex === 0 ? 'active' : '' %>">
                            <div class="row">
                                <% 
                                for (var j = 0; j < postsPerSlide; j++) { 
                                    postIndex = postIndex + j;
                                    if (postIndex >= totalSlides) {
                                        break;
                                    }
                                    var post = recentPosts[postIndex]; 
                                    var thumbnail = post.image || '/assets/images/placeholder.jpg'; 
                                %>
                                <div class="col-md-6 d-flex">
                                    <a href="<%= url_for(post.path) %>" class="card read-next-card d-flex flex-column">
                                        <img src="<%= url_for(thumbnail) %>" class="card-img-top" alt="<%= post.title %>">
                                        <div class="card-body d-flex flex-column">
                                            <h3 class="card-title"><%= post.title %></h3>
                                            <p class="card-text flex-grow-1">
                                                <%= post.excerpt ? post.excerpt.replace(/<\/?[^>]+(>|$)/g, "").substring(0, 100) + '...' : '' %>
                                            </p>
                                        </div>
                                    </a>
                                </div>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
                <!-- Carousel Controls -->
                <a class="carousel-control-prev" href="#readNextCarousel" role="button" data-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#readNextCarousel" role="button" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>
        <% } %>
        <!-- End of Read Next Carousel -->
    </div>
</div>
<script>
    window.addEventListener("load", function(){
        // add support to make headers to be clickable
        document.querySelectorAll("h1, h2, h3, h4, h5, h6").forEach(function(element){
            element.addEventListener("click", function(event){
                element_id = element.getAttribute("id");
                if (element_id) {
                    window.location = "#" + element_id;
                }
            }, true);
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        var carousel = document.getElementById("readNextCarousel");
        var touchStartX = 0;
        var touchEndX = 0;

        function handleSwipe() {
            if (touchEndX < touchStartX - 50) {
                // Swipe left → Move to next slide
                var nextBtn = document.querySelector("#readNextCarousel .carousel-control-next");
                if (nextBtn) nextBtn.click();
            } else if (touchEndX > touchStartX + 50) {
                // Swipe right → Move to previous slide
                var prevBtn = document.querySelector("#readNextCarousel .carousel-control-prev");
                if (prevBtn) prevBtn.click();
            }
        }

        carousel.addEventListener("touchstart", function (event) {
            touchStartX = event.changedTouches[0].screenX;
        });

        carousel.addEventListener("touchend", function (event) {
            touchEndX = event.changedTouches[0].screenX;
            handleSwipe();
        });
    });
</script>
