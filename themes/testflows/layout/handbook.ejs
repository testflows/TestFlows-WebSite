<div class="handbook">
    <div class="container handbook-inner">
        <div class="handbook-layout row">
            <div id="Top-of-the-handbook"></div>
            <nav id="sidebar" class="col-lg-4 sidebar handbook-toc">
                <div id="Contents" class="handbook-toc-header">
                    <h2>Contents</h2>
                </div>
                <div class="handbook-toc-body">
                    <% site.pages.each(function(chapter) { %>
                        <% if (chapter.path.startsWith(page.path)) { %>
                            <% if (page.title == chapter.title) { %>
                                <%- toc(page.content) %>
                            <% } else { %>
                                <div><a class="toc-link" href="/<%- chapter.path %>#Contents"><%- chapter.title %></a></div>
                            <% } %>
                        <% } %>
                    <% }); %>
                </div>
            </nav>
            <div class="col-lg-8 handbook-article">
                <%- page.content %>
                <div class="handbook-divider"></div>
                <div class="handbook-nav">
                    <% if (page.prev) { %>
                        <a class="handbook-nav-link handbook-nav-prev" href="/handbook<%- url_for(page.prev) %>.html#Contents"><span class="fas fa-arrow-left" aria-hidden="true"></span> Back</a>
                    <% } %>
                    <% if (page.next) { %>
                        <a class="handbook-nav-link handbook-nav-next" href="/handbook<%- url_for(page.next) %>.html#Contents">Next <span class="fas fa-arrow-right" aria-hidden="true"></span></a>
                    <% } %>
                </div>
            </div>
            <div class="handbook-jump">
                <button type="button" class="handbook-jump-top" onclick="document.getElementById('Top-of-the-handbook').scrollIntoView({ behavior: 'smooth' });" aria-label="Back to top">
                    <span class="fas fa-chevron-up" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>
<script>
    window.addEventListener("load", function(){
        document.querySelectorAll(".handbook h1, .handbook h2, .handbook h3, .handbook h4, .handbook h5, .handbook h6").forEach(function(element){
            element.addEventListener("click", function(event){
                var element_id = element.getAttribute("id");
                var toc_element = document.querySelector(".toc .toc-item .toc-link[href=\"#" + encodeURI(element_id) + "\"]");
                if (!toc_element) {
                    return;
                }
                toc_element.scrollIntoView({block: 'center'});
                toc_element.classList.add("active");
                setTimeout(function(){
                    toc_element.classList.remove("active");
                }, 1000);
            }, true);
        });
    });
</script>
