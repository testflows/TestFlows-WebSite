<% if (!page.path.startsWith("assets")) { %>
<!DOCTYPE HTML>
<html lang="en">
<%- partial('_partial/head') %>
<body>
  <a class="sr-only sr-only-focusable skip-link" href="#main">Skip to content</a>
  <% if (page.portal_nav) { %>
  <%- partial('_partial/navigation_portal') %>
  <% } else { %>
  <%- partial('_partial/navigation') %>
  <% } %>
  <%- partial('_partial/ai_markdown', {part: 'body'}) %>
  <div class="container-fluid p-0">
    <main class="content" id="main" tabindex="-1">
      <%- body %>
    </main>
  </div>
  <% if (!page.hide_footer) { %>
  <div class="container-footer" id="container-footer">
    <footer> <%- partial('_partial/footer') %> </footer>
  </div>
  <% } %>
  <%- partial('_partial/after_footer') %>
</body>
</html>
<% } else { %>
<%- body %>
<% } %>

